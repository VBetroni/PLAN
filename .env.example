# Copiá este archivo como .env.local y completá los valores. Nunca subas .env.local al repositorio.

# Supabase (Project Settings -> Data API / API Keys). Usá el proyecto de DESARROLLO en tu PC.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: solo servidor y tests. Nunca con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SECRET_KEY=

# Poné true solo en tu PC para correr los tests de base de datos contra el proyecto de DESARROLLO.
RUN_DB_TESTS=false
